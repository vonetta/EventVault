# MongoDB Atlas (free M0 tier is enough for ~50 guests)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/eventvault?retryWrites=true&w=majority

# Admin gate for /admin (at least 12 characters in production)
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Team photo-upload gate for /upload (photographers can add gallery photos only,
# not full admin). Use a DIFFERENT password than ADMIN_PASSWORD (at least 12
# characters in production). Leave unset to disable team uploads entirely.
UPLOADER_PASSWORD=change-me-to-a-different-long-password

# Signed guest/admin sessions (REQUIRED in production: >= 32 random chars)
SESSION_SECRET=replace-with-at-least-32-random-characters

# Public site URL used in ticket emails (use your live Vercel URL in production)
APP_URL=https://event-vault-dusky.vercel.app

# Cloudflare R2 (required in production for photos). Leave blank for local /uploads only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eventvault
# Do NOT set a public bucket URL for private guest media.
# Media is always served through /api/media/:id after authorization.

# Ticket email via personal Gmail (App Password — not your normal password)
# 1. Turn on 2-Step Verification for the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (spaces optional)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional display name in the From header
EMAIL_FROM_NAME=Koinonia Retreat

# Individual-photo paywall (Stripe hosted Checkout). Leave STRIPE_SECRET_KEY
# unset to disable purchases (in development the vault unlocks immediately for
# testing; in production the button is disabled until configured).
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint you create for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Price to unlock a guest's individual photos, in the smallest currency unit
# (e.g. 1500 = $15.00). Defaults to 1500.
PERSONAL_PHOTOS_PRICE_CENTS=1500
PERSONAL_PHOTOS_CURRENCY=usd
