# MongoDB Atlas (free M0 tier is enough for ~50 guests)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/eventvault?retryWrites=true&w=majority

# Admin gate for /admin
ADMIN_PASSWORD=change-me

# Signed guest sessions
SESSION_SECRET=replace-with-long-random-string

# Optional: Cloudflare R2 (cheapest media storage). Without these, files store locally in /uploads (dev only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eventvault
R2_PUBLIC_BASE_URL=

# Optional later: email ticket codes
# RESEND_API_KEY=
# EMAIL_FROM=EventVault <noreply@yourdomain.com>
